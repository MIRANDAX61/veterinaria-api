generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role { 
  VETERINARIO
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String  @default("0123456")
  role     Role
  veterinario Veterinario?

  @@map("users")
}


model Propietario {
  id  Int   @id @default(autoincrement())
  nombre String
  telefono String?
  correo  String? @unique
  @@map("propietarios")
}

model Mascota {
  id Int @id @default(autoincrement())
  nombre String
  fecha_nacimiento DateTime @db.Date
  sexo Sexo 
  raza String
  obs_importantes String
  receta Receta[]
  historial_visitas Historial_visitas?
  @@map("mascotas")
}

model Veterinario {
  id Int @id @default(autoincrement())
  nombre String
  telefono String
  correo String @unique
  userId            Int                 @unique
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  historial_visitas Historial_visitas[]
  @@map("veterinarios")
}

model Medicamento {
  id Int @id @default(autoincrement())
  nombre String
  fecha_vencimiento DateTime @db.Date
  marca String
  lote String
  receta Receta[]
  @@map("medicamento")
}

model Receta {
  id Int @id @default(autoincrement())
  medicamento_id Int
  medicamento Medicamento @relation(fields: [medicamento_id], references: [id])
  mascota_id Int
  mascota Mascota @relation(fields: [mascota_id], references: [id])
  historial_visitas Historial_visitas[]
}

model Historial_visitas {
  id Int @id @default(autoincrement())
  mascota_id Int @unique
  mascota Mascota @relation(fields: [mascota_id], references: [id])
  fecha DateTime @db.Date
  veterinario_id Int 
  veterinario Veterinario @relation(fields: [veterinario_id], references: [id])
  receta_id Int?
  receta Receta? @relation(fields: [receta_id], references: [id])
  motivo String
  diagnostico String
  tratamiento String
}

enum Sexo {
  MACHO
  HEMBRA
}